# Portable git settings, tracked in dotfiles.
#
# Anything machine-specific -- identity, corporate CA paths, SSH key routing,
# absolute paths -- belongs in ~/.gitconfig.local, which is gitignored and
# included at the BOTTOM of this file so its values win on conflict.
#
# Do NOT run `git config --global ...` to add settings here: ~/.gitconfig is a
# symlink to this tracked file, so those writes land in the repo. Use
# `git config --file ~/.gitconfig.local ...` instead.

[color]
    branch = auto
    diff = auto
    interactive = auto
    status = auto

[push]
    default = current

[alias]
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all

[core]
    autocrlf = input
    editor = /usr/bin/vim
    excludesfile = ~/.gitignore_global
    pager = delta
    # Default assumes the repo is at ~/.dotfiles; install/macos.sh writes the
    # real path to ~/.gitconfig.local, which overrides this.
    hooksPath = ~/.dotfiles/git/hooks

[pull]
    rebase = true

[init]
    defaultBranch = main

[fetch]
    prune = true
    pruneTags = false

[rebase]
    autoStash = true
    autoSquash = true

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[branch]
    sort = -committerdate

[rerere]
    enabled = true

[help]
    autocorrect = prompt

[credential]
    helper = osxkeychain

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true

# Homebrew and its taps clone themselves over https and need no auth at all.
# Mapping this prefix to itself wins on longest-match, opting brew out of any
# https -> SSH rewrite a machine may define in ~/.gitconfig.local. Keeps
# `brew update` working on a machine whose default GitHub key is restricted.
[url "https://github.com/Homebrew/"]
    insteadOf = https://github.com/Homebrew/

# Machine-local overrides. Must stay LAST: git takes the final value of a
# single-valued key, so this lets ~/.gitconfig.local override anything above.
[include]
    path = ~/.gitconfig.local
