# Template for ~/.npmrc -- portable defaults only.
#
# install/macos.sh SEEDS ~/.npmrc from this file on first run; it is
# deliberately NOT symlinked. `npm config set` / `pnpm config set` write to
# ~/.npmrc, so a symlink here would push machine-local values -- and any auth
# token -- straight into this repo.
#
# Machine-local values (corporate CA, registry tokens) belong in ~/.npmrc.
# Changing a default here only affects machines seeded after the change.

# 🔗 Use the public npm registry
registry=https://registry.npmjs.org/

# 📦 Save exact versions (no ^ or ~)
save-exact=true

# 🚫 Don't generate package-lock.json by default (optional)
package-lock=false

# ⏱ Set a global fetch timeout (in ms)
fetch-timeout=60000

# 💡 Uncomment for scoped registries (e.g., GitHub or private)
# @my-org:registry=https://npm.pkg.github.com/

# 🔑 Auth token for private registry (scoped). Keep real tokens in ~/.npmrc,
# never here.
# //npm.pkg.github.com/:_authToken=${NPM_TOKEN}
